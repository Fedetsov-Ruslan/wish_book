BOT_TOKEN=your_telegram_bot_token_here

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=wishbook
POSTGRES_USER=wishbook
POSTGRES_PASSWORD=changeme

REDIS_URL=redis://redis:6379/0
NOTIFICATION_DELAY_SECONDS=300

# Public HTTPS origin the Mini App is served from (Telegram requires TLS).
WEBAPP_URL=https://wish-book-bot.isgood.host

# Self-hosted MinIO (S3-compatible) for wish attachments — internal only,
# also used as the MinIO container's root user/password.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=wishbook
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=wishbook-attachments
MINIO_SECURE=false

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_fernet_key_here
